# Runtime (API server)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_intake
# Retell private API key. The server uses it to verify webhook signatures; the sync script uses it to provision.
RETELL_API_KEY=

# Provisioning only (pnpm retell:sync) - not needed by the running server
# Public URL of the deployed API, e.g. https://voice-intake-api.up.railway.app
API_BASE_URL=
# US area code for the provisioned phone number (defaults to 415)
RETELL_PHONE_AREA_CODE=
# Retell voice id for the agent (defaults to 11labs-Myra); see `retell.voice.list()`
RETELL_VOICE_ID=
