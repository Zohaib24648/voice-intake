          "value": "\"patients\".\"date_of_birth\" between date '1900-01-01' and current_date"
        },
        "patients_phone_number_digits": {
          "name": "patients_phone_number_digits",
          "value": "\"patients\".\"phone_number\" ~ '^[0-9]{10}$'"
        },
        "patients_emergency_contact_phone_digits": {
          "name": "patients_emergency_contact_phone_digits",
          "value": "\"patients\".\"emergency_contact_phone\" is null or \"patients\".\"emergency_contact_phone\" ~ '^[0-9]{10}$'"
        },
        "patients_state_code": {
          "name": "patients_state_code",
          "value": "\"patients\".\"state\" ~ '^[A-Z]{2}$'"
        },
        "patients_zip_code_format": {
          "name": "patients_zip_code_format",
          "value": "\"patients\".\"zip_code\" ~ '^[0-9]{5}(-[0-9]{4})?$'"
