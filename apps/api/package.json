{
  "name": "@voice-intake/api",
  "version": "0.1.0",
  "private": true,
  "description": "Patient registration REST API and Retell voice-agent webhooks.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "retell:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-retell.ts"
  },
  "dependencies": {
    "@voice-intake/shared": "workspace:*",
    "@date-fns/tz": "^1.4.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "retell-sdk": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
